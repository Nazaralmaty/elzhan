THIN = {'sub': 4, 'pop': 2} if PAL == 'icon' else {}
_thin = {}

# 21.09.2026 (Elzhan on atlas/reel_017: «поработай чуть чуть с таймингами звуков sfx»).
# Камера жанра canvas держит ПЯТЬ ключей на бит, и каждый ключ просил свой свуш: замер
# reel_017 — 93 свуша на 73.3 с, медианный зазор 0.59 с, минимальный 0.09. Слой читался
# одним непрерывным шелестом, и отдельное движение в нём уже не слышно. Два закона:
#   MIN_GAP — повторяющийся звук события звучит не чаще, чем раз в N секунд (слышен первый
#             ключ бита, промежуточные молчат);
#   SEAM    — проезд камеры молчит рядом со швом мира: у шва свой звук (ирис, полоса,
#             вспышка, ризер), и свуш поверх него съедает атаку.
_PK = json.loads((LIB / 'peaks.json').read_text()) if (LIB / 'peaks.json').exists() else {}
SEAM = {'iris', 'band', 'flash', 'hard', 'zoom', 'tr_blur', 'tr_card', 'tr_pop', 'plate', 'dive'}
MIN_GAP = {'cam': 1.6} if PAL in ('canvas', 'speaker') else {'html': 0.12, 'cam': 1.6} if PAL == 'literal' else {'word': 0.22, 'punch': 0.8} if PAL == 'kinetic' else {'morph': 0.30, 'row': 0.18} if PAL == 'apple-speaker' else {'key': 0.12, 'cam': 1.6} if PAL == 'apple' else {}
SEAM_GUARD = 0.40
_seam_t = sorted(c["t"] for c in CUES if c["k"] in SEAM)
_last_k, _seen = {}, set()
for c in CUES:
    t, k = c["t"], c["k"]
    if (round(t, 3), k) in _seen: continue          # один и тот же кий дважды в один кадр = один звук вдвое громче
    _seen.add((round(t, 3), k))
    if k in THIN:
        _thin[k] = _thin.get(k, -1) + 1
        if _thin[k] % THIN[k]: continue
    if k in MIN_GAP:
        if k in _last_k and t - _last_k[k] < MIN_GAP[k]: continue
        if any(abs(t - st) < SEAM_GUARD for st in _seam_t): continue
        _last_k[k] = t
    if k.startswith('sfx:'):   # ролик назвал звук сам: `sfx: [{ at, s: 'water_pour' }]` в спеке.
        # Палитра знает ЖАНР, а не тему: бассейн, сердце, деньги приходят с роликом.
        nm, _, lv = k[4:].partition('@'); lv, _, ct = lv.partition('~')   # `~сек` — длина: гул и ризер без неё играют весь файл
        # by the PEAK, not the start (/sound §1): the named event is the moment the object lands; a bed or drone starts on it
        pk = 0 if nm.startswith('bed_') or 'drone' in nm else _PK.get(nm, {}).get('peak', 0)
        ev(t - pk, nm, float(lv) if lv else 0.26, float(ct) if ct else None); continue
    for spec in MAP.get(k, []):
        off, name, v = spec[0], spec[1], spec[2]; cut = spec[3] if len(spec) > 3 else None
        if name == 'PAN': name = PAN[pan_i % len(PAN)]; pan_i += 1
        if name == 'CLICK': name = CLICK[tok_i % len(CLICK)]; v = v if tok_i % 2 else v + 0.03; tok_i += 1
        if name == 'CLICKPRO': name = CLICKPRO[cp_i % len(CLICKPRO)]; cp_i += 1
        if name == 'CAMPAN': name = CAMPAN[cam_i % len(CAMPAN)]; cam_i += 1
        if name == 'RISER': name = RISER[ris_i % len(RISER)]; ris_i += 1
        if name == 'POPSOFT': name = POPSOFT[ps_i % len(POPSOFT)]; ps_i += 1
        if name == 'TICKBODY': name = TICKBODY[tb_i % len(TICKBODY)]; tb_i += 1
        if name == 'SOFTMORPH': name = SOFTMORPH[sm_i % len(SOFTMORPH)]; sm_i += 1
        if name == 'SWISH': name = SWISH[sw_i % len(SWISH)]; sw_i += 1
        if name == 'LAND': name = LAND[ld_i % len(LAND)]; ld_i += 1
        ev(t + off, name, v, cut)
if PAL == 'icon':
    ev(0.0, 'icon_riser_hook', 0.20)   # the hook frame builds to the first cut
if PAL not in ('archive', 'speaker', 'icon', 'goz', 'apple-speaker', 'literal'):
    ev(DUR - 1.05, 'tick_metal', 0.12)

# fill holes > 0.55 s with dry ticks every 0.30 s at half level
_ts = sorted(t for t, _, _, _ in E) if PAL not in ('archive', 'speaker', 'literal', 'gold', 'canvas', 'icon', 'limbo', 'goz', 'board', 'kinetic', 'apple-speaker', 'apple') else []   # canvas: no hole filling at all (13.09.2026, Elzhan: too many sfx)
FILL = ['tick_wood', 'click_soft']; _fi = 0
for i in range(len(_ts) - 1):
    a, b = _ts[i], _ts[i + 1]; t = a + 0.30
    while b - t > (1.1 if PAL == 'canvas' else 0.28):   # canvas (13.09.2026, Elzhan: too many sfx): holes under 1.4 s stay silent
        ev(t, FILL[_fi % 2], 0.075); _fi += 1; t += 0.30

# ── auto-cut: a sound never runs longer than the shot it belongs to ─────────
# 14.09.2026 (Elzhan): «обрежь ситуативно с затуханием, чтобы звук не звучал дольше, чем
# нужно в кадре». The frame's own clock is the cue list: an event owns the frame until the
# next cue. So the allowed length = time to the next cue + TAIL, never cutting before the
# file's peak (peaks.json) — a sample trimmed before its peak leaves a click (/sound §0).
# Sustained roles (riser, drone, bed, sub drop, charge, long shine) are exempt: their job is
# to run under what follows. An explicit cut in MAP still wins when it is shorter.
TAIL = 0.35
_SFXMAX = (json.loads(Path('reel.json').read_text()).get('sfx_max')
           if Path('reel.json').exists() else None)
SUSTAIN = ('riser', 'drone', 'bed_', 'sub_drop', 'charge', 'shine_long', 'counter_run')
PEAKS = json.loads((LIB / 'peaks.json').read_text()) if (LIB / 'peaks.json').exists() else {}
CUE_T = sorted(c["t"] for c in CUES)
def allowed(tm, name, cut):
    # reel.json "sfx_max": потолок длины ОДНОГО эффекта в секундах. Без него эффект звенит до
    # следующего куэ, и в редкой сцене это 1.5–2 с («некоторые длятся дольше, чем должны быть»,
    # Элжан 07.10.2026). Тянущиеся по замыслу (riser, drone, bed_, counter_run) потолку не подчиняются.
    MAX = _SFXMAX
    if any(s in name for s in SUSTAIN): return cut
    nxt = next((t for t in CUE_T if t > tm + 0.06), None)
    if nxt is None: return cut if MAX is None else min(cut or MAX, MAX)
    a = max(nxt - tm + TAIL, PEAKS.get(name, {}).get('peak', 0) + 0.18, 0.22)
    if MAX is not None: a = min(a, max(MAX, PEAKS.get(name, {}).get('peak', 0) + 0.18))
    return a if cut is None else min(cut, a)

buf = np.zeros(int(DUR * SR) + SR, dtype=np.float32)
cache = {}; missing = set(); trimmed = 0
for tm, name, vol, cut in E:
    cut = allowed(tm, name, cut)
    if name not in cache:
        f = next((p for p in LIB.rglob(f"{name}.*") if p.suffix in ('.wav', '.mp3') and '/_' not in str(p)), None)
        if f is None: missing.add(name); cache[name] = None
        else:
            raw = subprocess.run(["ffmpeg", "-v", "error", "-i", str(f), "-ar", str(SR), "-ac", "1", "-f", "s16le", "-"], capture_output=True, check=True).stdout
            cache[name] = np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768
    a = cache[name]
    if a is None: continue
    if cut and len(a) > int(cut * SR):   # trim to the length of the event, fade out so the cut is not heard
        a = a[:int(cut * SR)].copy(); f = min(int(0.12 * SR), len(a) // 3)
        if f > 0: a[-f:] *= np.linspace(1, 0, f, dtype=np.float32)
        trimmed += 1
    k = int(tm * SR); n = min(len(a), len(buf) - k)
    if n > 0: buf[k:k + n] += a[:n] * vol
if missing: print("not in library:", ", ".join(sorted(missing)), file=sys.stderr)

ts = sorted(t for t, _, _, _ in E)
gaps = np.diff(ts) if len(ts) > 1 else np.array([0])
if GAPS:
    print(f"events {len(E)}, {len(E) / DUR * 60:.0f}/min, median gap {np.median(gaps):.2f} s")
    for i, g in enumerate(gaps):
        if g > 0.7: print(f"  hole {g:.2f} s at {ts[i]:.2f}")
    sys.exit(0)
buf = buf[:int(DUR * SR)]
# /mnt-sfx §1, measured not judged: the isolated SFX layer peaks 5–6 dB below the voice peak. At 10 dB the
# events are inaudible and the reel reads as empty (12.09.2026: a canvas score landed at −11.6 vs voice −1.9).
_v = Path('work/_voice.wav')
if _v.exists() and len(E):
    raw = subprocess.run(["ffmpeg", "-v", "error", "-i", str(_v), "-ac", "1", "-f", "s16le", "-"], capture_output=True).stdout
    vpk = np.abs(np.frombuffer(raw, dtype=np.int16)).max() / 32768; spk = np.abs(buf).max()
    if vpk > 0 and spk > 0:
        g = min(4.0, (vpk * 10 ** (-5.5 / 20)) / spk); buf *= g
        print(f"SFX layer: peak {20*np.log10(spk):.1f} → {20*np.log10(spk*g):.1f} dBFS (voice {20*np.log10(vpk):.1f}), gain ×{g:.2f}")
_cfg = json.loads(Path('reel.json').read_text()) if Path('reel.json').exists() else {}
if _cfg.get('sfx_gain', 1) != 1:   # reel.json sfx_gain: the whole layer after peak matching (0.7 = 30 % quieter)
    buf *= _cfg['sfx_gain']; print(f"SFX layer ×{_cfg['sfx_gain']} (reel.json sfx_gain)")
np.clip(buf, -1, 1, out=buf)
Path('work').mkdir(exist_ok=True)
w = wave.open('work/_sfx.wav', 'wb'); w.setnchannels(1); w.setsampwidth(2); w.setframerate(SR)
w.writeframes((buf * 32767).astype(np.int16).tobytes()); w.close()
print(f"SFX: {len(E)} events, {len(E) / DUR * 60:.0f}/min, {trimmed} trimmed to their shot, max silence {gaps.max():.2f} s → work/_sfx.wav")
