DUR = D["DUR"]; CUES = D["cues"]

E = []
GAIN = 0.82
def ev(tm, name, v, cut=None):
    # cut = seconds: the sample is trimmed to this length with a fade-out. A map entry
    # may carry it as a 4th field. 13.09.2026 (Elzhan on fragrancia/reel_036): a long
    # sample keeps running where the event is already over — counter_run 3.52 s under a
    # 0.9 s counter read as one unbroken rattle. Length is part of «звук к месту».
    if 0 <= tm <= DUR: E.append((round(tm, 3), name, v * GAIN, cut))

